<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Master Remote"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking IR blaster..."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnAllOff"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="⏻  SAB TV BAND KARO"
        android:textSize="20sp"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnTvOff"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📺  Sirf TV band karo"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAcOff"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="❄️  Sirf AC band karo (LG / Samsung)"
        android:textSize="14sp" />

</LinearLayout>
